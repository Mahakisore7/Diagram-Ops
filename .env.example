# Copy this file to .env and fill in real values. .env is gitignored and must
# never be committed. This file holds names and placeholders only.
#
# None of these are read by the application itself. They are your personal
# notes for values that get typed by hand into /etc/default/jenkins on the
# Jenkins server (over an SSM session), where Jenkins Configuration as Code
# picks them up. Mapping to the variable names in /etc/default/jenkins is
# noted per line.

# Old SonarQube token from the SonarQube instance that was destroyed when the
# Jenkins EC2 instance was replaced. No longer valid; safe to delete.
Sonar_Qube_Token = '<obsolete>'

# Current SonarQube token (SonarQube UI > My Account > Security > Generate
# Token, type "User Token"). -> SONARQUBE_TOKEN
Sonar_Qube_Token_2 = 'squ_<token>'

# GitHub fine-grained personal access token, scoped to the Diagram-Ops repo.
# -> GITHUB_PAT
Github_Finegrained_AccessToken = "github_pat_<token>"

# Anthropic API key. -> ANTHROPIC_API_KEY
Anthropics_API_Key = "sk-ant-api03-<key>"

# NVD API key (nvd.nist.gov/developers/request-an-api-key). Used by OWASP
# Dependency-Check; without it the vulnerability database sync is very slow
# and rate-limited. -> NVD_API_KEY
NVD_API_Key = "<uuid-style-key>"
