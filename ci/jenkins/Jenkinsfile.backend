@Library('diagramforge-shared') _

pipeline {
    agent any

    parameters {
        booleanParam(name: 'FORCE_BUILD', defaultValue: false,
            description: 'Run the full pipeline even if the latest commit has no backend changes (e.g. to rebuild and push the image of main).')
    }

    environment {
        BACKEND_REPO = "diagramforge-backend"
        AWS_REGION   = "ap-south-1"
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
                script {
                    env.GIT_SHA_SHORT = sh(script: "git rev-parse --short HEAD", returnStdout: true).trim()
                    // Resolved from the Jenkins server's own IAM role at run time,
                    // not hardcoded: the same Jenkinsfile then works in any AWS
                    // account (and survived the move to a new one unchanged).
                    env.ECR_REGISTRY = sh(script: "aws sts get-caller-identity --query Account --output text", returnStdout: true).trim() + ".dkr.ecr.${env.AWS_REGION}.amazonaws.com"
                }
            }
        }

        stage('Check Relevant Changes') {
            steps {
                script {
                    def changes = sh(script: "git diff --name-only HEAD~1 HEAD || true", returnStdout: true).trim()
                    if (!params.FORCE_BUILD && !changes.contains('application/backend/') && !changes.contains('Jenkinsfile.backend')) {
                        currentBuild.result = 'NOT_BUILT'
                        error("No backend changes — skipping this pipeline run")
                    }
                }
            }
        }

        stage('Install Dependencies') {
            steps { dir('application/backend') { sh 'npm ci' } }
        }

        stage('Unit Tests') {
            steps {
                dir('application/backend') {
                    // tests/integration.test.js drives the app against a REAL
                    // MongoDB (GitHub Actions provides one as a service
                    // container; Jenkins has none). Start a throwaway one on a
                    // random localhost port so concurrent builds cannot clash,
                    // and always remove it afterwards.
                    sh '''#!/bin/bash
                        set -e
                        NAME="mongo-test-${BUILD_TAG//[^a-zA-Z0-9_.-]/_}"
                        docker run -d --name "$NAME" -p 127.0.0.1::27017 mongo:7 >/dev/null
                        trap 'docker rm -f "$NAME" >/dev/null 2>&1 || true' EXIT
                        PORT=$(docker port "$NAME" 27017/tcp | head -1 | sed 's/.*://')
                        for i in $(seq 1 30); do
                          docker exec "$NAME" mongosh --quiet --eval 'db.runCommand({ping:1})' >/dev/null 2>&1 && break
                          sleep 2
                        done
                        MONGO_URI="mongodb://127.0.0.1:$PORT/diagramops-test" npm test -- --ci --coverage --coverageReporters=lcov --coverageReporters=text-summary
                    '''
                }
            }
        }

        stage('SonarQube Scan') {
            when { branch 'main' }  // Community Edition keeps one analysis timeline per project
            steps {
                dir('application/backend') {
                    sonarQubeScan(projectKey: 'diagramforge-backend', sourcePath: 'src')
                }
            }
        }

        stage('OWASP Dependency-Check') {
            steps {
                dir('application/backend') {
                    owaspDependencyCheck(
                        projectName: 'diagramforge-backend',
                        scanPath: '.',
                        suppressionFile: 'dependency-check-suppression.xml'
                    )
                }
            }
        }

        stage('Docker Build') {
            steps {
                dir('application/backend') {
                    sh "docker build -t diagramforge-backend:${env.GIT_SHA_SHORT} ."
                }
            }
        }

        stage('Trivy Image Scan') {
            steps {
                trivyScan(image: "diagramforge-backend:${env.GIT_SHA_SHORT}")
            }
        }

        stage('Push to ECR') {
            when { branch 'main' }
            steps {
                pushToECR(
                    region: env.AWS_REGION,
                    registry: env.ECR_REGISTRY,
                    repoName: env.BACKEND_REPO,
                    localImage: "diagramforge-backend:${env.GIT_SHA_SHORT}"
                )
            }
        }

        stage('Update GitOps Manifest') {
            when { branch 'main' }
            steps {
                // Jenkins never deploys and never writes to main. It records the new
                // image tag on the gitops-deploy branch (main + tag bumps), which is
                // what ArgoCD watches, so main's review rules stay meaningful. The
                // retry covers the backend and frontend pipelines pushing together.
                withCredentials([usernamePassword(credentialsId: 'github-credentials', usernameVariable: 'GIT_USER', passwordVariable: 'GIT_PASS')]) {
                    sh '''
                        set -e
                        git config user.email "jenkins-ci@diagramforge.local"
                        git config user.name "Jenkins CI"
                        export GIT_ASKPASS=$(mktemp)
                        trap 'rm -f "$GIT_ASKPASS"' EXIT
                        printf '#!/bin/sh\\ncase "$1" in Username*) echo "$GIT_USER";; *) echo "$GIT_PASS";; esac\\n' > "$GIT_ASKPASS"
                        chmod 700 "$GIT_ASKPASS"
                        for attempt in 1 2 3; do
                          git fetch origin +refs/heads/main:refs/remotes/origin/main
                          git fetch origin +refs/heads/gitops-deploy:refs/remotes/origin/gitops-deploy || true
                          if git rev-parse -q --verify origin/gitops-deploy >/dev/null; then
                            git checkout -B gitops-deploy origin/gitops-deploy
                            git merge --no-edit origin/main
                          else
                            git checkout -B gitops-deploy origin/main
                          fi
                          # plain sed: yq would re-flow the file's inline maps and make the diff noisy
                          sed -i '/^backend:/,/^[a-z]/ s/^    tag: .*/    tag: sha-'"$GIT_SHA_SHORT"'/' charts/three-tier-app/values-prod.yaml
                          git add charts/three-tier-app/values-prod.yaml
                          git diff --cached --quiet || git commit -m "ci(gitops): deploy backend sha-$GIT_SHA_SHORT"
                          git push origin gitops-deploy && exit 0
                        done
                        exit 1
                    '''
                }
            }
        }
    }

    post {
        always  { cleanWs() }
        failure { echo "Backend pipeline failed — check which gate above stopped it before assuming it's a 'flaky' failure." }
    }
}
