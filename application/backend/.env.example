# Copy to .env for local development. Never commit the real .env — it's
# already covered by the repo .gitignore, but double-check before every push.

NODE_ENV=development
PORT=5000

# MongoDB — docker-compose service name "mongo" when running via Compose,
# localhost when running the backend directly on your machine
MONGO_URI=mongodb://mongo:27017/diagramops

# JWT — generate a real random value with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-me-with-a-random-64-char-string
JWT_EXPIRES_IN=24h

# LLM providers
DEFAULT_LLM_PROVIDER=groq
FALLBACK_LLM_PROVIDER=claude
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# Daily hard cap on paid-provider (Claude) calls — see docs/adr/0004-cap-checked-before-call.md
DAILY_CLAUDE_CALL_CAP=50

# Per-user request rate limit
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=30

# No CORS_ORIGIN here on purpose. The frontend always calls a relative
# /api path — nginx proxies it in Docker/prod, and the Vite dev server
# proxies it during `npm run dev`. The backend never receives a
# cross-origin request, so there's nothing to configure.
# See docs/adr/0007-nginx-api-proxy.md.
