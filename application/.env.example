# Copy to application/.env for `docker compose up`. Docker Compose
# auto-loads a .env file from the SAME DIRECTORY as docker-compose.yaml for
# ${VARIABLE} substitution INSIDE that file — a separate mechanism from
# application/backend/.env, which Node's own `dotenv` package reads when
# you run the backend directly (npm run dev, node src/server.js). Compose
# never touches backend/.env at all; it builds the image and injects
# environment: values from THIS file instead. Two files, two different
# tools each reading their own.

JWT_SECRET=replace-me-with-a-random-64-char-string
GROQ_API_KEY=
ANTHROPIC_API_KEY=
DAILY_CLAUDE_CALL_CAP=50
